<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- CORRECCIÓN AQUÍ: Añadido un salto de línea y espacios -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EVONIAPP"
        tools:targetApi="31">

        <!-- Tu Activity principal (probablemente MainActivity) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.EVONIAPP">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- =================== Bloque de Activities de Invitados =================== -->
        <activity
            android:name=".ui.screens.GuestListActivity"
            android:exported="false"
            android:label="Invitados Boda"
            android:theme="@style/Theme.EVONIAPP" />

        <activity
            android:name=".ui.screens.AddGuestActivity"
            android:exported="false"
            android:label="Agregar Invitado"
            android:theme="@style/Theme.EVONIAPP" />

        <activity
            android:name=".ui.screens.EditGuestActivity"
            android:exported="false"
            android:label="Detalles del Invitado"
            android:theme="@style/Theme.EVONIAPP" />
        <!-- ======================================================================= -->

    </application>

</manifest>
